NEXT_PUBLIC_SITE_URL=http://localhost:3001
SITE_INDEXABLE=false
WORDPRESS_INTERNAL_URL=http://127.0.0.1:8888
# Keep this origin aligned with WP_HOME and WP_SITEURL in wordpress/.wp-env.json.
# Local setup enables fictional checkout only; it never charges or dispatches.
# Public deployment requires rotating all demo credentials and runtime secrets.
